# =====================================================================
#  MAEL Backend - biến môi trường
#  Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# =====================================================================

# ---- Server ----
SERVER_PORT=8089
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.lovable.app,https://*.lovableproject.com
UPLOAD_DIR=uploads
# Captcha cho form đăng ký và form tư vấn (tắt = false khi test bằng Postman)
CAPTCHA_ENABLED=true

# ---- PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/mael
DB_USERNAME=postgres
DB_PASSWORD=

# ---- JWT (Base64, tối thiểu 256 bit). Tạo mới: openssl rand -base64 48 ----
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ---- AI: mock | gemini ----
# gemini: dùng 4 key Gemini cho 4 tác vụ riêng. mock: chỉ chạy kịch bản soạn sẵn, không gọi AI
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# 1) Phòng thảo luận 3 AI (học sinh tự gõ câu hỏi, tóm tắt buổi học)
GEMINI_KEY_DISCUSSION=
# 2) Phân tích cá nhân hoá điểm mạnh / yếu, gợi ý ải nên chơi
GEMINI_KEY_ANALYSIS=
# 3) Đọc PDF giảng viên tải lên -> soạn câu hỏi, lỗi sai hay gặp, câu cho mini game
GEMINI_KEY_DOCUMENT=
# 4) Giải toán từ ảnh chụp
GEMINI_KEY_PHOTO=
# Đường dẫn file JSON service account của Google Cloud (Speech-to-Text / Text-to-Speech)
GOOGLE_APPLICATION_CREDENTIALS=
# API key Google Cloud có bật "Cloud Text-to-Speech API": 3 AI đọc bằng 3 giọng khác nhau.
# Để trống thì web dùng giọng đọc có sẵn của trình duyệt (vẫn khác cao độ / tốc độ cho từng AI)
GOOGLE_TTS_API_KEY=

# ---- Thanh toán: mock | momo ----
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_CONFIRM_ENABLED=true
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:5173/checkout/result
# Phải là HTTPS công khai (dùng ngrok khi dev), ví dụ: https://xxxx.ngrok-free.app/api/payments/momo/ipn
MOMO_IPN_URL=

# ---- Cloudinary (lưu ảnh, tài liệu) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (Gmail SMTP, dùng App Password) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
